ARCHONTOS_ENV=dev
ARCHONTOS_DATABASE_URL=postgresql+asyncpg://archontos:archontos@localhost:5432/archontos
ARCHONTOS_MINIO_ENDPOINT=localhost:9000
ARCHONTOS_MINIO_ACCESS_KEY=archontos
ARCHONTOS_MINIO_SECRET_KEY=change-me
ARCHONTOS_MINIO_SECURE=false
ARCHONTOS_MINIO_BUCKET=archontos
ARCHONTOS_ARTIFACT_BACKEND=local
ARCHONTOS_ARTIFACT_LOCAL_PATH=local-data/artifacts
ARCHONTOS_ALLOWED_JURISDICTIONS=KR
ARCHONTOS_OTEL_ENABLED=false
ARCHONTOS_LAWGO_OC=
ARCHONTOS_LAWGO_BASE_URL=https://www.law.go.kr/DRF
# memory (default, no database) or postgres (canonical action + projection drain)
ARCHONTOS_ACTION_BACKEND=memory
# comma-separated; empty leaves APIs open
ARCHONTOS_API_KEYS=
