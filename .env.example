ARCHONTOS_ENV=dev
ARCHONTOS_DATABASE_URL=postgresql+asyncpg://archontos:archontos@localhost:5432/archontos
# Optional: put every ArchOntos table in this schema (e.g. regulation) when sharing a database with Sion core
ARCHONTOS_DB_SCHEMA=
ARCHONTOS_MINIO_ENDPOINT=localhost:9000
ARCHONTOS_MINIO_ACCESS_KEY=archontos
ARCHONTOS_MINIO_SECRET_KEY=change-me
ARCHONTOS_MINIO_SECURE=false
ARCHONTOS_MINIO_BUCKET=archontos
ARCHONTOS_ARTIFACT_BACKEND=local
ARCHONTOS_ARTIFACT_LOCAL_PATH=local-data/artifacts
ARCHONTOS_ALLOWED_JURISDICTIONS=KR
ARCHONTOS_OTEL_ENABLED=false
ARCHONTOS_LAWGO_OC=
ARCHONTOS_LAWGO_BASE_URL=https://www.law.go.kr/DRF
# memory (default, no database) or postgres (canonical action + projection drain)
ARCHONTOS_ACTION_BACKEND=memory
# comma-separated; empty leaves APIs open
ARCHONTOS_API_KEYS=
# none (embedding stays NULL) | hashing (deterministic, no deps) | fastembed (pip install 'archontos[embeddings]')
ARCHONTOS_EMBEDDER=none
# fastembed model; default sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ARCHONTOS_EMBEDDING_MODEL=
ARCHONTOS_EMBEDDING_CACHE_DIR=
# off | warn | enforce: refuse to start when the DB login is superuser/BYPASSRLS/table owner
ARCHONTOS_DB_PRIVILEGE_CHECK=warn
# Password of the services' DB login archontos_svc (compose provisions it after migrations)
ARCHONTOS_APP_DB_PASSWORD=archontos-svc-dev
# Empty disables authorization; else actor:role+role (viewer|proposer|approver|executor|operator|admin)
ARCHONTOS_ACTOR_ROLES=
# Per-actor jurisdictions for row-level security (default: ARCHONTOS_ALLOWED_JURISDICTIONS)
ARCHONTOS_ACTOR_JURISDICTIONS=
# pgvector HNSW query tuning (build params: python -m archontos.db.vector_index --help)
ARCHONTOS_HNSW_EF_SEARCH=40
ARCHONTOS_HNSW_ITERATIVE_SCAN=strict_order
ARCHONTOS_HNSW_MAX_SCAN_TUPLES=20000
# Optional OIDC/JWT identity (RS256): set issuer, audience and jwks_url together, or none
ARCHONTOS_OIDC_ISSUER=
ARCHONTOS_OIDC_AUDIENCE=
ARCHONTOS_OIDC_JWKS_URL=
ARCHONTOS_OIDC_ACTOR_CLAIM=sub
ARCHONTOS_OIDC_ROLES_CLAIM=roles
ARCHONTOS_OIDC_JURISDICTIONS_CLAIM=jurisdictions
ARCHONTOS_OIDC_LEEWAY_SECONDS=30
# Structured request log on stdout: json | text | off
ARCHONTOS_LOG_FORMAT=json
ARCHONTOS_LOG_LEVEL=INFO
