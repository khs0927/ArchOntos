arch:observedArtifact a owl:ObjectProperty .
arch:inputSnapshot a owl:ObjectProperty .
arch:fromSnapshot a owl:ObjectProperty .
arch:hasRepresentation a owl:ObjectProperty .
arch:sameContentAs a owl:ObjectProperty .
arch:correspondsTo a owl:ObjectProperty .
arch:supersedes a owl:ObjectProperty .
arch:evidence a owl:ObjectProperty .
