@prefix arch: <urn:arch:v4:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:arch:v4> a owl:Ontology ;
 rdfs:comment "Reference vocabulary; not an IFC or KBimCode conformance claim." .
arch:SourceArtifact a owl:Class ; rdfs:subClassOf prov:Entity .
